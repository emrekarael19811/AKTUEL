# ============================================================
# AKTÜEL Çevre Değişkenleri - .env.example
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyasını asla git'e commit etmeyin!
# ============================================================

# --- Uygulama ---
APP_NAME=AKTUEL
DEBUG=false
SECRET_KEY=change-this-to-a-strong-random-secret

# --- Supabase / PostgreSQL ---
DATABASE_URL=postgresql://postgres:your-password@db.mxzklnsaddxvldwckwir.supabase.co:5432/postgres
SUPABASE_URL=https://mxzklnsaddxvldwckwir.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PRODUCTS=aktuel_products

# --- OpenAI (GPT-4o Vision - Opsiyonel) ---
OPENAI_API_KEY=sk-...

# --- Google Vision (Opsiyonel) ---
GOOGLE_VISION_CREDENTIALS_PATH=/app/secrets/google-vision.json

# --- Firebase FCM ---
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-adminsdk.json
FCM_SERVER_KEY=your-fcm-server-key

# --- Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://mxzklnsaddxvldwckwir.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
